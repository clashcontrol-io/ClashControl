{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only the native clash-engine commands. No core:* plugin permissions (no fs, shell, dialog, opener...).",
  "windows": ["main"],
  "permissions": [
    "allow-register-meshes",
    "allow-register-mesh",
    "allow-unregister-mesh",
    "allow-clear-meshes",
    "allow-intersect-batch",
    "allow-min-dist-batch",
    "allow-engine-info"
  ]
}
